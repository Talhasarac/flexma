# Flexma as a plain systemd service (no Docker), e.g. on a small VPS that
# already runs other things. Install: see docs/deploy-digitalocean.md.
[Unit]
Description=Flexma design server
After=network-online.target
Wants=network-online.target

[Service]
User=flexma
Group=flexma
EnvironmentFile=/etc/flexma/flexma.env
ExecStart=/opt/flexma/flexma
WorkingDirectory=/var/lib/flexma
StateDirectory=flexma
Restart=always
RestartSec=2

# Be a good neighbour on a small server: cap Flexma's RAM, and make it the
# first thing the OOM killer picks instead of other services. Past the cap it
# moves cold memory to swap (add a swapfile, see docs/deploy-digitalocean.md)
# instead of being killed. No MemoryHigh: at a soft limit without swap the
# kernel throttles the process until it stops answering, while staying
# "active" so Restart= never fires.
MemoryMax=600M
MemorySwapMax=2G
OOMScoreAdjust=500
Nice=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/flexma

[Install]
WantedBy=multi-user.target
