# /etc/flexma/flexma.env — read by flexma.service
FLEXMA_ADDR=127.0.0.1:8080
# The URL people open (with the port if it isn't 443).
FLEXMA_PUBLIC_URL=https://design.example.com
FLEXMA_DATA_DIR=/var/lib/flexma
FLEXMA_WEB_DIR=/opt/flexma/web
# Longest side of PNG exports. Keep it at 4096 or below on 1 GB servers.
FLEXMA_MAX_EXPORT_PX=4096
FLEXMA_INSTANCE_NAME=Flexma
RUST_LOG=flexma=info,tower_http=warn
